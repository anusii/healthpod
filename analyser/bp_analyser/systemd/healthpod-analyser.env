# Secrets for the HealthPod blood pressure analyser.
#
# Install as /etc/healthpod-analyser.env with mode 600, owned by root.
# Values here override anything in config.yaml.

# The security key the Analyser Pod was initialised with in HealthPod.
HEALTHPOD_ANALYSER_SECURITY_KEY=

# Client credentials issued by the Solid server for the Analyser account.
HEALTHPOD_ANALYSER_CLIENT_ID=
HEALTHPOD_ANALYSER_CLIENT_SECRET=

# Optional: guards POST /api/refresh.
HEALTHPOD_ANALYSER_API_TOKEN=
